includes:
    - phpstan-baseline.neon
parameters:
    level: 5
    paths:
        - src
        - database
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelAppends: true
    checkModelProperties: true
    ignoreErrors:
        - '#Unsafe usage of new static\(\).#'
        - '#Trait Step2dev\\LazyAdmin\\Authorization\\HasLazyAdminPermissions is used zero times and is not analysed\.#'
